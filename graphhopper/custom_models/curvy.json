// Profilo "curvy" v2 — usa gli encoded value della pipeline (fun_curvature 0-100,
// fun_signals 0-15) al posto della curvature nativa di GraphHopper.
// Principio: solo PENALITA' (multiply_by <= 1), mai bonus; il divertimento e'
// uno sconto relativo, cosi' l'ottimizzazione non degenera in loop.
// Soglie tarate sulla distribuzione reale (pipeline 2026-07-06, Nord-Ovest):
// passi alpini 55-70+, statali guidabili 20-45, rettilinei/urbano 0-5.
// Trunk a 0.5 (non 0.3): in Italia molte statali leggendarie (es. SS45 Val
// Trebbia) sono taggate trunk; le superstrade vere restano uccise dal
// rettilineo (fun_curvature < 5).
// distance_influence basso (15 vs 90 di fast) = deviazioni lunghe ma curve ok.
// ATTENZIONE: dopo una modifica serve il re-import (scripts/import.ps1):
// i profili sono salvati nel graph-cache all'import.
{
  "distance_influence": 15,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },

    { "if": "road_class == MOTORWAY", "multiply_by": "0.15" },
    { "else_if": "road_class == TRUNK", "multiply_by": "0.5" },
    { "else_if": "road_class == PRIMARY", "multiply_by": "0.7" },
    { "else_if": "road_class == RESIDENTIAL", "multiply_by": "0.5" },
    { "else_if": "road_class == LIVING_STREET", "multiply_by": "0.3" },
    { "else_if": "road_class == SERVICE", "multiply_by": "0.3" },
    { "else_if": "road_class == TRACK", "multiply_by": "0.2" },

    { "if": "road_environment == TUNNEL", "multiply_by": "0.5" },

    { "if": "urban_density == CITY", "multiply_by": "0.4" },
    { "else_if": "urban_density == RESIDENTIAL", "multiply_by": "0.7" },

    { "if": "fun_curvature < 5", "multiply_by": "0.55" },
    { "else_if": "fun_curvature < 25", "multiply_by": "0.7" },
    { "else_if": "fun_curvature < 45", "multiply_by": "0.85" },

    { "if": "fun_signals >= 4", "multiply_by": "0.55" },
    { "else_if": "fun_signals >= 2", "multiply_by": "0.75" },

    { "if": "surface == GRAVEL || surface == FINE_GRAVEL || surface == DIRT || surface == GROUND || surface == UNPAVED || surface == SAND || surface == COBBLESTONE || surface == COMPACTED", "multiply_by": "0.2" },
    { "if": "smoothness == BAD || smoothness == VERY_BAD || smoothness == HORRIBLE || smoothness == VERY_HORRIBLE || smoothness == IMPASSABLE", "multiply_by": "0.3" }
  ],
  "speed": [
    { "if": "true", "limit_to": "car_average_speed" }
  ]
}
